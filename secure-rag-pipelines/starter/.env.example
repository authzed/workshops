# Chat model — bring your own. Embeddings run locally (fastembed), so the
# only key you need is for the LLM that writes the final answer.
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4

# Endpoint for the chat model. Leave BLANK for OpenAI. Set it to use any
# OpenAI-compatible provider or your company's gateway, e.g.:
#   Anthropic (Claude):  LLM_BASE_URL=https://api.anthropic.com/v1/   LLM_MODEL=claude-sonnet-4-6
#   Groq:                LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
#   Local Ollama:        LLM_BASE_URL=http://localhost:11434/v1       LLM_MODEL=llama3.1
#   Company endpoint:    LLM_BASE_URL=https://llm.yourcompany.com/v1  LLM_MODEL=<your-model>
LLM_BASE_URL=

# Local infra defaults — match docker-compose.yml; no need to change for the workshop
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
SPICEDB_ENDPOINT=localhost:50051
SPICEDB_TOKEN=devtoken

# Agent behavior (Checkpoint 1 + 2 use the default of 1)
MAX_RETRIEVAL_ATTEMPTS=1
LOG_LEVEL=INFO
